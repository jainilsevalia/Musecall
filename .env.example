# Copy to .env for local runs. Never commit real values.

# Public HTTPS origin of this bridge (Twilio and Genie call it). No trailing slash.
PUBLIC_BASE_URL=https://calls.example.com
PORT=8080

# SHA-256 of the API key issued to Genie (`npm run issue-key`). The key itself is never stored.
BRIDGE_API_KEY_SHA256=
# Random secret (32+ chars) for signing per-call media stream tokens: `openssl rand -hex 32`
STREAM_TOKEN_SECRET=

# Jainil's own Twilio account (paid, not the client account).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_FROM=+1XXXXXXXXXX
# sync | async | off   (see README "Voicemail")
AMD_MODE=sync
RING_TIMEOUT_SECONDS=30

OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_EXTRACTION_MODEL=gpt-4o-mini

PRINCIPAL_NAME=Jainil Sevalia

DATABASE_PATH=./data/bridge.db
RETENTION_DAYS=30
MAX_CONCURRENT_CALLS=1
MAX_DURATION_CAP_SECONDS=900
ALLOWED_TO_PREFIXES=+1
