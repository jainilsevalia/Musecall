{
  "name": "genie-call-bridge",
  "version": "0.1.0",
  "description": "Outbound calling bridge for Genie: Twilio + OpenAI Realtime behind a small HTTP API",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "issue-key": "tsx scripts/issue-key.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@fastify/websocket": "^11.3.4",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "twilio": "^6.2.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "private": "true",
  "engines": {
    "node": ">=22"
  }
}
